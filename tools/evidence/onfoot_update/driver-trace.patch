+// ============================================================================
+//  trace.h - read-only per-frame call trace for aadriver.
+//
+//  Installs entry detours on x2game.dll functions that only count calls and
+//  record (function id, ECX) in memory; the target prologue is replayed in the
+//  detour, so the game's registers, stack and flags are unchanged. No game
+//  state is written. A frame boundary is taken from CScriptSystem::Update of
+//  the System Lua state (aadriver's existing hook).
+//
+//  Pipe op 'K' payload commands (run on the client main thread):
+//    install <module>+<rva> ...   patch the listed functions
+//    info                         hook/frame/row counters
+//    clear                        drop rows and pending entries
+//    dump <start> <max>           rows as "K ..." / "E ..." lines
+//    uninstall                    restore the original prologues
+// ============================================================================
+#pragma once
+
+#include <string>
+
+namespace trace {
+
+std::string command(const std::string& spec);
+
+// Called at the start of CScriptSystem::Update for the System Lua state.
+void frameBoundary();
+
+bool active();
+
+} // namespace trace
